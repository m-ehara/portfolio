{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "group:allNonMajor",
    "config:best-practices",
    ":timezone(Asia/Tokyo)",
    "schedule:weekends",
    ":label(deps)",
    ":pinDevDependencies"
  ],
  "minimumReleaseAge": "14 days",
  "major": {
    "dependencyDashboardApproval": true
  },
  "nodenv": {
    "dependencyDashboardApproval": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Auto-merge non-major updates after minimum release age and CI passes",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
