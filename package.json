{
  "name": "my-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "test:ui:update": "playwright test --update-snapshots",
    "lint": "oxlint src infra tests",
    "fmt": "oxfmt -w src infra tests",
    "fmt:check": "oxfmt --check src infra tests",
    "knip": "knip",
    "kv:put:remote": "node infra/sync-kv.ts"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "knip": "6.47.0",
    "oxfmt": "0.79.0",
    "oxlint": "0.18.1",
    "typescript": "7.0.2",
    "vite": "6.4.6",
    "vitest": "^3.1.3",
    "wrangler": "4.166.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": ["darwin", "linux"],
      "cpu": ["arm64", "x64"]
    }
  }
}
